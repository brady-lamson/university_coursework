library(dplyr)
library(igraph)
edges <- c(
"s","t", "s","y", "s","z", "s","u",
"t","y", "t","z", "t","u", "t","x", "t","v",
"u","v", "u","x", "u","w",
"v","w", "v","x",
"w","x", "x","y", "x","z", "y","z"
)
igraph::graph(edges) %>%
plot()
knitr::include_graphics("images/whw1_prob2_g1_colored.png")
